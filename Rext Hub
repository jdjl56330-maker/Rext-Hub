local function applyStats()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = Config.Misc.SpeedBoost and 28 or Config.Misc.WalkSpeed
        hum.JumpPower = Config.Misc.JumpPower
    end
end

local function flyStep()
    if not Config.Misc.Fly then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local dir = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
    root.AssemblyLinearVelocity = dir.Magnitude > 0 and dir.Unit * Config.Misc.FlySpeed or Vector3.zero
end

local function noclipStep()
    if not Config.Misc.Noclip then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end

local function hitboxStep()
    if not Config.Misc.Hitbox then
        for plr in pairs(hitboxApplied) do hitboxApplied[plr] = nil end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and alive(plr) and enemy(plr, true) then
            local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if root and not hitboxApplied[plr] then
                pcall(function()
                    root.Size = Vector3.new(Config.Misc.HitboxX, Config.Misc.HitboxY, Config.Misc.HitboxZ)
                    root.Transparency = Config.Misc.HitboxTrans
                    root.CanCollide = false
                    root.Massless = true
                end)
                hitboxApplied[plr] = true
            end
        end
    end
end

local function gunHook()
    local char = LocalPlayer.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _, v in ipairs(tool:GetDescendants()) do
                local n = v.Name:lower()
                if Config.Misc.NoRecoil then
                    if n:find("recoil") or n:find("spread") or n:find("kick") or n:find("bloom") then
                        if v:IsA("NumberValue") or v:IsA("IntValue") then pcall(function() v.Value = 0 end) end
                    end
                end
                if Config.Misc.InfAmmo then
                    if n:find("ammo") or n:find("clip") or n:find("mag") or n:find("bullets") or n:find("rounds") or n:find("maxammo") then
                        if v:IsA("NumberValue") or v:IsA("IntValue") then pcall(function() v.Value = 999 end) end
                    end
                end
            end
            if Config.Misc.InfAmmo then
                pcall(function()
                    tool:SetAttribute("Ammo", 999)
                    tool:SetAttribute("MaxAmmo", 999)
                end)
            end
        end
    end
end

local function createESP(plr)
    if ESPObjects[plr] then return end
    local t = {}
    if Drawing then
        t.box = Drawing.new("Square")
        t.box.Thickness = 1.2 t.box.Filled = false t.box.Color = Config.ESP.Color t.box.Visible = false
        t.name = Drawing.new("Text")
        t.name.Size = 13 t.name.Center = true t.name.Outline = true t.name.Color = Color3.new(1,1,1) t.name.Visible = false
        t.hp = Drawing.new("Text")
        t.hp.Size = 12 t.hp.Center = true t.hp.Outline = true t.hp.Color = Color3.fromRGB(255,80,80) t.hp.Visible = false
        t.dist = Drawing.new("Text")
        t.dist.Size = 11 t.dist.Center = true t.dist.Outline = true t.dist.Color = Color3.fromRGB(180,180,180) t.dist.Visible = false
        t.tracer = Drawing.new("Line")
        t.tracer.Thickness = 1 t.tracer.Color = Config.ESP.Color t.tracer.Visible = false
    end
    t.hl = Instance.new("Highlight")
    t.hl.FillTransparency = 0.7 t.hl.OutlineColor = Config.ESP.Color t.hl.FillColor = Config.ESP.Color t.hl.Enabled = false
    ESPObjects[plr] = t
end

local function removeESP(plr)
    local t = ESPObjects[plr]
    if not t then return end
    for _, v in pairs(t) do
        if typeof(v) == "Instance" then pcall(function() v:Destroy() end)
        else pcall(function() v:Remove() end) end
    end
    ESPObjects[plr] = nil
end

local function updateESP()
    if not Config.ESP.Enabled then
        for _, t in pairs(ESPObjects) do
            for _, v in pairs(t) do
                if typeof(v) ~= "Instance" then pcall(function() v.Visible = false end)
                else pcall(function() v.Enabled = false end) end
            end
        end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not ESPObjects[plr] then createESP(plr) end
            local t = ESPObjects[plr]
            local char = plr.Character
            local show = alive(plr) and (not Config.ESP.TeamCheck or enemy(plr, true))
            if show and char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if root and hum then
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local top = Camera:WorldToViewportPoint(root.Position + Vector3.new(0,3,0))
                        local bottom = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
                        local h = math.abs(top.Y - bottom.Y)
                        local w = h * 0.6
                        if t.box then
                            t.box.Size = Vector2.new(w,h)
                            t.box.Position = Vector2.new(pos.X-w/2, pos.Y-h/2)
                            t.box.Visible = Config.ESP.Boxes
                            t.box.Color = Config.ESP.Color
                        end
                        if t.name then
                            t.name.Text = plr.Name
                            t.name.Position = Vector2.new(pos.X, pos.Y-h/2-14)
                            t.name.Visible = Config.ESP.Names
                        end
                        if t.hp then
                            t.hp.Text = math.floor(hum.Health).."hp"
                            t.hp.Position = Vector2.new(pos.X, pos.Y+h/2+2)
                            t.hp.Visible = Config.ESP.Health
                        end
                        if t.dist then
                            t.dist.Text = math.floor((root.Position-Camera.CFrame.Position).Magnitude).."m"
                            t.dist.Position = Vector2.new(pos.X, pos.Y+h/2+14)
                            t.dist.Visible = Config.ESP.Distance
                        end
                        if t.tracer then
                            t.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                            t.tracer.To = Vector2.new(pos.X, pos.Y)
                            t.tracer.Visible = Config.ESP.Tracers
                        end
                        if t.hl then
                            t.hl.Adornee = char
                            t.hl.Parent = char
                            t.hl.Enabled = Config.ESP.Chams
                        end
                    else
                        for _, v in pairs(t) do if typeof(v) ~= "Instance" then pcall(function() v.Visible = false end) end end
                    end
                end
            else
                for _, v in pairs(t) do
                    if typeof(v) ~= "Instance" then pcall(function() v.Visible = false end)
                    else pcall(function() v.Enabled = false end) end
                end
            end
        end
    end
end

