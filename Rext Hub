-- AIMBOT
----------------------------------------------------------------
local function aimbotStep()
    if not Config.Aimbot.Enabled then lockedTarget = nil return end
    local now = tick()
    local target = getClosest(Config.Aimbot.FOV, Config.Aimbot.TeamCheck, Config.Aimbot.WallCheck, 0)

    if lockedTarget and lockedTarget.Parent then
        local sp, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
        if onScreen then
            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < Config.Aimbot.FOV * 1.5 and (now - lockTime) < 0.65 then
                target = lockedTarget
            end
        end
    end

    if not target then lockedTarget = nil return end
    if target ~= lockedTarget then lockedTarget = target lockTime = now end

    local goal = CFrame.new(Camera.CFrame.Position, lockedTarget.Position)
    if Config.Aimbot.Blatant then
        Camera.CFrame = Camera.CFrame:Lerp(goal, 0.92)
    else
        Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(Config.Aimbot.Smooth, 0.2, 0.85))
    end

    if Config.Aimbot.AutoShoot and not mouseOverMain() then
        if now - lastShoot >= SHOOT_DELAY then
            lastShoot = now
            pcall(function()
                mouse1press()
                task.wait(0.03)
                mouse1release()
            end)
        end
    end
end
RunService:BindToRenderStep("RextAim", Enum.RenderPriority.Camera.Value + 1, aimbotStep)

----------------------------------------------------------------
-- SILENT AIM (hard lock on shoot)
----------------------------------------------------------------
local function silentStep()
    if not Config.Silent.Enabled then return end
    if mouseOverMain() then return end

    -- fire on click OR while holding
    local shooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    if not shooting then return end
    if math.random(1, 100) > Config.Silent.Hitchance then return end

    local t = getClosest(Config.Silent.FOV, Config.Silent.TeamCheck, Config.Silent.WallCheck, Config.Silent.Prediction)
    if not t then return end

    local pos = t.Position
    if Config.Silent.Airshot then
        local hum = t.Parent and t.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then
            pos = pos + Vector3.new(0, 1.2, 0)
        end
    end

    -- always hard snap for reliability; blatant = pure set, else near-instant lerp
    if Config.Silent.Blatant then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, pos)
    else
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), 0.97)
    end
end
-- bind silent at same priority so it wins the frame when shooting
RunService:BindToRenderStep("RextSilent", Enum.RenderPriority.Camera.Value + 2, silentStep)

