    headerTitle.BackgroundTransparency = 1
    headerTitle.Text = "rext hub"
    headerTitle.TextColor3 = C.text
    headerTitle.Font = Enum.Font.GothamBlack
    headerTitle.TextSize = 16
    headerTitle.TextXAlignment = Enum.TextXAlignment.Left
    headerTitle.Parent = header

    local headerSub = Instance.new("TextLabel")
    headerSub.Size = UDim2.new(0, 120, 1, 0)
    headerSub.Position = UDim2.new(0, 112, 0, 0)
    headerSub.BackgroundTransparency = 1
    headerSub.Text = "/  arsenal"
    headerSub.TextColor3 = C.dim
    headerSub.Font = Enum.Font.GothamMedium
    headerSub.TextSize = 13
    headerSub.TextXAlignment = Enum.TextXAlignment.Left
    headerSub.Parent = header

    local mini = Instance.new("TextButton")
    mini.Size = UDim2.new(0, 40, 0, 56)
    mini.Position = UDim2.new(1, -80, 0, 0)
    mini.BackgroundTransparency = 1
    mini.Text = "–"
    mini.TextColor3 = C.dim
    mini.Font = Enum.Font.GothamBold
    mini.TextSize = 18
    mini.Parent = header
    mini.MouseButton1Click:Connect(function() main.Visible = false end)

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 40, 0, 56)
    close.Position = UDim2.new(1, -40, 0, 0)
    close.BackgroundTransparency = 1
    close.Text = "×"
    close.TextColor3 = C.red
    close.Font = Enum.Font.GothamBold
    close.TextSize = 18
    close.Parent = header
    close.MouseButton1Click:Connect(function()
        gui:Destroy()
        mainFrame = nil
        pcall(function()
            RunService:UnbindFromRenderStep("RextAim")
            RunService:UnbindFromRenderStep("RextSilent")
        end)
        for _, c in pairs(Connections) do pcall(function() c:Disconnect() end) end
        for plr in pairs(ESPObjects) do removeESP(plr) end
        if FOVCircle then pcall(function() FOVCircle:Remove() end) end
    end)

    UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == Enum.KeyCode.K then
            if main and main.Parent then main.Visible = not main.Visible end
        end
    end)

    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -40, 0, 36)
    tabBar.Position = UDim2.new(0, 20, 0, 64)
    tabBar.BackgroundTransparency = 1
    tabBar.Parent = content

    local tabs = {"aimbot", "silent", "esp", "misc"}
    local tabBtns, pages = {}, {}
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 64, 0, 2)
    indicator.Position = UDim2.new(0, 0, 1, -2)
    indicator.BackgroundColor3 = C.red
    indicator.BorderSizePixel = 0
    indicator.Parent = tabBar

    local function switch(name, idx)
        for n, p in pairs(pages) do p.Visible = (n == name) end
        for n, b in pairs(tabBtns) do
            b.TextColor3 = (n == name) and C.text or C.dim
        end
        TweenService:Create(indicator, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
            Position = UDim2.new(0, (idx-1)*78, 1, -2),
            Size = UDim2.new(0, 56, 0, 2)
        }):Play()
    end

    for i, name in ipairs(tabs) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 70, 1, 0)
        b.Position = UDim2.new(0, (i-1)*78, 0, 0)
        b.BackgroundTransparency = 1
        b.Text = name
        b.TextColor3 = C.dim
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.Parent = tabBar
        tabBtns[name] = b

        local page = Instance.new("ScrollingFrame")
        page.Size = UDim2.new(1, -40, 1, -116)
        page.Position = UDim2.new(0, 20, 0, 108)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 2
        page.ScrollBarImageColor3 = C.redDim
        page.CanvasSize = UDim2.new(0, 0, 0, 520)
        page.Visible = false
        page.Parent = content
        pages[name] = page

        b.MouseButton1Click:Connect(function() switch(name, i) end)
    end
    switch("aimbot", 1)

    local function addSection(parent, text)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, 0, 0, 28)
        f.BackgroundTransparency = 1
        f.Parent = parent
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 1, 0)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = C.muted
        l.Font = Enum.Font.GothamBold
        l.TextSize = 11
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = f
    end

    local function addToggle(parent, text, default, cb)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, 0, 0, 40)
        f.BackgroundColor3 = C.bg3
        f.BorderSizePixel = 0
        f.Parent = parent
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

        local pad = Instance.new("UIPadding", f)
        pad.PaddingLeft = UDim.new(0, 14)
        pad.PaddingRight = UDim.new(0, 12)

        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -54, 1, 0)
        l.BackgroundTransparency = 1
        l.Text = text
        l.TextColor3 = C.text
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 13
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = f

        local track = Instance.new("TextButton")
        track.Size = UDim2.new(0, 44, 0, 24)
        track.Position = UDim2.new(1, -44, 0.5, -12)
        track.BackgroundColor3 = default and C.red or C.bg4
        track.Text = ""
        track.AutoButtonColor = false
        track.Parent = f
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 18, 0, 18)
        knob.Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        knob.BackgroundColor3 = Color3.new(1,1,1)
        knob.BorderSizePixel = 0
        knob.Parent = track
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local on = default
        track.MouseButton1Click:Connect(function()
            on = not on
            TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                Position = on and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
            }):Play()
            TweenService:Create(track, TweenInfo.new(0.18), {
                BackgroundColor3 = on and C.red or C.bg4
            }):Play()
            cb(on)
        end)
    end

    local function addSlider(parent, text, min, max, default, cb)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, 0, 0, 58)
        f.BackgroundColor3 = C.bg3
        f.BorderSizePixel = 0
        f.Parent = parent
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)

        local pad = Instance.new("UIPadding", f)
        pad.PaddingLeft = UDim.new(0, 14)
        pad.PaddingRight = UDim.new(0, 14)
        pad.PaddingTop = UDim.new(0, 10)

        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, 16)
        l.BackgroundTransparency = 1
        l.Text = text .. "   " .. default
        l.TextColor3 = C.text
        l.Font = Enum.Font.GothamMedium
        l.TextSize = 12
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = f

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, 0, 0, 5)
        bar.Position = UDim2.new(0, 0, 0, 32)
        bar.BackgroundColor3 = C.bg4
        bar.BorderSizePixel = 0
        bar.Parent = f
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((default-min)/(max-min), 0, 1, 0)
        fill.BackgroundColor3 = C.red
        fill.BorderSizePixel = 0
        fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local hold = false
        bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then hold = true end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then hold = false end end)
        UserInputService.InputChanged:Connect(function(i)
            if hold and i.UserInputType == Enum.UserInputType.MouseMovement then
                local r = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.new(r, 0, 1, 0)
                local v = math.floor(min + (max-min)*r)
                l.Text = text .. "   " .. v
                cb(v)
            end
        end)
    end

    local function lay(p)
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 6)
        l.Parent = p
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 2)
        pad.Parent = p
    end

    local ap = pages.aimbot
    lay(ap)
    addSection(ap, "COMBAT")
    addToggle(ap, "enabled", false, function(v) Config.Aimbot.Enabled = v end)
    addToggle(ap, "auto shoot", true, function(v) Config.Aimbot.AutoShoot = v end)
    addToggle(ap, "blatant", false, function(v) Config.Aimbot.Blatant = v end)
    addToggle(ap, "team check", true, function(v) Config.Aimbot.TeamCheck = v end)
    addToggle(ap, "wall check", false, function(v) Config.Aimbot.WallCheck = v end)
    addToggle(ap, "show fov", true, function(v) Config.Aimbot.ShowFOV = v end)
    addSection(ap, "TUNING")
    addSlider(ap, "fov", 50, 500, 200, function(v) Config.Aimbot.FOV = v if FOVCircle then FOVCircle.Radius = v end end)
    addSlider(ap, "smooth", 20, 90, 55, function(v) Config.Aimbot.Smooth = v/100 end)

    local sp = pages.silent
    lay(sp)
    addSection(sp, "SILENT AIM")
    addToggle(sp, "enabled", false, function(v) Config.Silent.Enabled = v end)
    addToggle(sp, "blatant", true, function(v) Config.Silent.Blatant = v end)
    addToggle(sp, "team check", true, function(v) Config.Silent.TeamCheck = v end)
    addToggle(sp, "wall check", false, function(v) Config.Silent.WallCheck = v end)
    addToggle(sp, "airshot", true, function(v) Config.Silent.Airshot = v end)
    addSection(sp, "TUNING")
    addSlider(sp, "fov", 50, 600, 300, function(v) Config.Silent.FOV = v end)
    addSlider(sp, "prediction", 0, 30, 14, function(v) Config.Silent.Prediction = v/100 end)
    addSlider(sp, "hitchance", 1, 100, 100, function(v) Config.Silent.Hitchance = v end)

    local ep = pages.esp
    lay(ep)
    addSection(ep, "VISUALS")
    addToggle(ep, "enabled", false, function(v) Config.ESP.Enabled = v end)
    addToggle(ep, "boxes", true, function(v) Config.ESP.Boxes = v end)
    addToggle(ep, "names", true, function(v) Config.ESP.Names = v end)
    addToggle(ep, "health", true, function(v) Config.ESP.Health = v end)
    addToggle(ep, "distance", true, function(v) Config.ESP.Distance = v end)
    addToggle(ep, "tracers", false, function(v) Config.ESP.Tracers = v end)
    addToggle(ep, "chams", true, function(v) Config.ESP.Chams = v end)
    addToggle(ep, "team check", true, function(v) Config.ESP.TeamCheck = v end)

    local mp = pages.misc
    lay(mp)
    addSection(mp, "MOVEMENT")
    addSlider(mp, "walkspeed", 16, 140, 16, function(v) Config.Misc.WalkSpeed = v applyStats() end)
    addSlider(mp, "jumppower", 50, 200, 50, function(v) Config.Misc.JumpPower = v applyStats() end)
    addToggle(mp, "speed boost", false, function(v) Config.Misc.SpeedBoost = v applyStats() end)
    addToggle(mp, "fly", false, function(v) Config.Misc.Fly = v end)
    addSlider(mp, "fly speed", 20, 150, 60, function(v) Config.Misc.FlySpeed = v end)
    addToggle(mp, "noclip", false, function(v) Config.Misc.Noclip = v end)
    addSection(mp, "WEAPON")
    addToggle(mp, "no recoil", false, function(v) Config.Misc.NoRecoil = v end)
    addToggle(mp, "inf ammo", false, function(v) Config.Misc.InfAmmo = v end)
    addToggle(mp, "hitbox", false, function(v)
        Config.Misc.Hitbox = v
        if not v then for k in pairs(hitboxApplied) do hitboxApplied[k] = nil end end
    end)
    addSlider(mp, "hitbox x", 2, 18, 6, function(v) Config.Misc.HitboxX = v end)
    addSlider(mp, "hitbox y", 2, 18, 6, function(v) Config.Misc.HitboxY = v end)
    addSlider(mp, "hitbox z", 2, 18, 6, function(v) Config.Misc.HitboxZ = v end)

    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true dragStart = i.Position startPos = main.Position
        end
    end)
    header.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
        end
    end)

    if Drawing then
        FOVCircle = Drawing.new("Circle")
        FOVCircle.Thickness = 1.2
        FOVCircle.NumSides = 64
        FOVCircle.Radius = Config.Aimbot.FOV
        FOVCircle.Filled = false
        FOVCircle.Color = C.red
        FOVCircle.Visible = false
    end
end

