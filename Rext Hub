-- HELPERS
----------------------------------------------------------------
local function alive(plr)
    local c = plr.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function enemy(plr, check)
    if not check then return true end
    return not (plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team)
end

local function visibleCheck(from, to, char)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(from, to - from, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(char)
end

local function getClosest(fov, team, wall, pred)
    local best, bestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local camPos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and alive(plr) and enemy(plr, team) then
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            if head then
                local pos = head.Position
                if pred and pred > 0 then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then pos = pos + root.AssemblyLinearVelocity * pred end
                end
                local sp, onScreen = Camera:WorldToViewportPoint(pos)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestDist then
                        if not wall or visibleCheck(camPos, pos, char) then
                            best, bestDist = head, d
                        end
                    end
                end
            end
        end
    end
    return best
end

local function mouseOverMain()
    if not mainFrame or not mainFrame.Visible or not mainFrame.Parent then return false end
    local m = UserInputService:GetMouseLocation()
    local p, s = mainFrame.AbsolutePosition, mainFrame.AbsoluteSize
    return m.X >= p.X and m.X <= p.X+s.X and m.Y >= p.Y and m.Y <= p.Y+s.Y
end

